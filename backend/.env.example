# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL or SQLite fallback)
# PostgreSQL: postgresql://build8_user:build8_secret@localhost:5432/build8now_db?schema=public
# SQLite fallback: file:./dev.db
DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET="super_secret_jwt_key_build8now_production_grade_2026_secure"
JWT_EXPIRES_IN="7d"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN="http://localhost:3000"

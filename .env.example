# Build8Now Monorepo Environment Variables Reference
# =======================================================
# 1. Backend Service (backend/.env)
# -------------------------------------------------------
PORT=5000
NODE_ENV=development
DATABASE_URL="file:./dev.db" # Or postgresql://build8_user:build8_secret@localhost:5432/build8now_db?schema=public
JWT_SECRET="super_secret_jwt_key_build8now_production_grade_2026_secure"
JWT_EXPIRES_IN="7d"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN="http://localhost:3000"

# -------------------------------------------------------
# 2. Frontend Application (frontend/.env)
# -------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL="http://localhost:5000/api/v1"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
